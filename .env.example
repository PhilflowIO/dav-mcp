# =============================================================================
# AUTHENTICATION METHOD
# =============================================================================
# Choose authentication method (case-insensitive): 'Basic', 'Digest' or 'OAuth'
# Default: Basic. Basic also works against Digest-only servers: dav-mcp
# switches to Digest when the server's 401 offers only Digest, after sending
# the password once Basic-encoded on its first request.
# Digest never sends the password itself, only Digest responses to the
# server's challenge; it needs Node.js 20 or newer.
AUTH_METHOD=Basic

# =============================================================================
# BASIC / DIGEST AUTH (Standard CalDAV Servers)
# =============================================================================
# Use these for Radicale, Baikal, Nextcloud, etc.
# Used when AUTH_METHOD=Basic, AUTH_METHOD=Digest or not set
CALDAV_SERVER_URL=https://dav.philflow.io
CALDAV_USERNAME=radicale_admin
CALDAV_PASSWORD=your-password-here

# =============================================================================
# OAUTH2 (Google Calendar)
# =============================================================================
# Use these for Google Calendar and other OAuth2-enabled CalDAV servers
# Only used when AUTH_METHOD=OAuth
#
# To get these credentials:
# 1. Go to https://console.developers.google.com/
# 2. Create a project and enable "Google Calendar API" and "CalDAV API"
# 3. Create OAuth 2.0 credentials (Desktop application)
# 4. Get a refresh token using OAuth 2.0 Playground or similar tool
#
GOOGLE_SERVER_URL=https://apidata.googleusercontent.com/caldav/v2/
GOOGLE_USER=your-email@gmail.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# =============================================================================
# HTTP SERVER CONFIGURATION (only for --http mode / Docker)
# =============================================================================
PORT=3000
BEARER_TOKEN=your-secure-token-here

# =============================================================================
# TOOL-CALL LOG (debugging and evaluation, off by default)
# =============================================================================
# Records every tool call with its full arguments - calendar and contact data.
# LOG_TOOL_CALLS=true
# Where: 'file' (default), 'console' (stderr under stdio) or 'both'
# TOOL_CALL_LOG_MODE=file
# Default file: $XDG_STATE_HOME/dav-mcp/tool-calls.jsonl, else
# ~/.local/state/dav-mcp/tool-calls.jsonl (%LOCALAPPDATA%\dav-mcp\ on Windows),
# created readable by its owner only.
# TOOL_CALL_LOG_FILE=/path/to/tool-calls.jsonl

# Optional: CORS origins (comma-separated, default: localhost:5678,localhost:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:5678,http://localhost:3000
